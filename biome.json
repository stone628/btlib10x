{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "src/**",
      "tests/**",
      "scripts/**",
      "web/**",
      "data/**",
      "functions/**",
      "!web/terminal.js",
      "!web/instant.js",
      "!web/btlib10x.js",
      "!web/btlib10x.d.ts",
      "!web/avatar.js",
      "!web/gallery.js",
      "!web/gallery-admin.js",
      "!web/avatar/avatar.glyphs.ts",
      "!web/btlib10x.data.js",
      "!data/**/*.json"
    ]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**", "!tests/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noFocusedTests": "off"
          }
        }
      }
    },
    {
      "includes": ["tests/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "../src": "Import the module that defines the symbol, not the src barrel (docs/GAME_REFACTORING.md section 3).",
                  "../src/index": "Import the module that defines the symbol, not the src barrel (docs/GAME_REFACTORING.md section 3).",
                  "../../src": "Import the module that defines the symbol, not the src barrel (docs/GAME_REFACTORING.md section 3).",
                  "../../src/index": "Import the module that defines the symbol, not the src barrel (docs/GAME_REFACTORING.md section 3)."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/rules/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "../index": "Import the module that defines the symbol, not the src barrel (docs/GAME_REFACTORING.md section 3).",
                  "../../index": "Import the module that defines the symbol, not the src barrel (docs/GAME_REFACTORING.md section 3)."
                }
              }
            }
          }
        }
      }
    }
  ]
}
