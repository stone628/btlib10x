{
  "name": "btlib10x",
  "version": "0.0.1",
  "description": "TypeScript library encapsulating BattleTech Total Warfare board game logic (subset)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "data/btlib10x.jsonl"
  ],
  "sideEffects": false,
  "scripts": {
    "pack": "node scripts/pack-catalog.mjs",
    "pack:sw": "node scripts/pack-catalog.mjs --mechs docs/mtf/sw/json --maps none --out docs/mtf/sw/sw.jsonl",
    "pack:ia": "node scripts/pack-catalog.mjs --mechs none --maps web/instant/maps --out web/instant/instant.jsonl",
    "mtf": "node scripts/mtf.mjs && npm run pack",
    "prebuild": "node -e \"import('node:fs').then((fs) => fs.rmSync('dist', { recursive: true, force: true }))\"",
    "build": "tsc -b tsconfig.build.json",
    "build:web": "node scripts/build-web.mjs && node scripts/build-dts.mjs",
    "dist:web": "node scripts/build-web.mjs && node scripts/build-dts.mjs && node scripts/dist-web.mjs",
    "dist:standalone": "node scripts/standalone-web.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-default.mjs",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "test:changed": "vitest run --changed",
    "test:related": "vitest related --run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "dev:web": "node scripts/build-web.mjs --watch --serve"
  },
  "keywords": [
    "battletech",
    "boardgame",
    "rules-engine",
    "typescript"
  ],
  "license": "MIT",
  "author": "stone628",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "rollup": "^4.62.5",
    "rollup-plugin-dts": "^6.2.3",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5"
  }
}
