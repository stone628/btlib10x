{
  "name": "btlib10x",
  "version": "0.0.1",
  "description": "TypeScript library encapsulating BattleTech Total Warfare board game logic (subset)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "data"
  ],
  "sideEffects": false,
  "scripts": {
    "gen:mechs": "node scripts/gen-mech-catalog.mjs && biome check --write src/data/mechCatalog.generated.ts",
    "mtf": "node scripts/mtf.mjs && npm run gen:mechs",
    "build": "npm run gen:mechs && tsc -p tsconfig.build.json",
    "build:web": "node scripts/build-web.mjs",
    "dist:web": "node scripts/build-web.mjs && node scripts/dist-web.mjs",
    "dist:standalone": "node scripts/standalone-web.mjs",
    "typecheck": "npm run gen:mechs && tsc --noEmit",
    "test": "npm run gen:mechs && vitest run",
    "test:watch": "npm run gen:mechs && vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "dev:web": "node scripts/build-web.mjs --watch --serve"
  },
  "keywords": [
    "battletech",
    "boardgame",
    "rules-engine",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
