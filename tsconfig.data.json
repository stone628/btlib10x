{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "outDir": "dist/data-bundle",
    "rootDir": "data",
    "declaration": true,
    "sourceMap": true,
    "declarationMap": true,
    "tsBuildInfoFile": "dist/data.tsbuildinfo"
  },
  "include": ["data/index.ts", "data/*.json", "data/mechs/*.json", "data/maps/*.json"],
  "references": [{ "path": "./tsconfig.build.json" }]
}
